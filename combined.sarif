            {
              "id": "wapiti-inconsistent-redirection",
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An HTTP 3xx redirection response should typically contain only minimal content (or none), as clients are expected to follow the Location header. However, this response also contains HTML content (such as links or forms). This may confuse clients, expose unintended information, or allow attackers to craft malicious redirections."
              },
              "name": "Inconsistent Redirection",
              "properties": {
                "references": [
                  "https://www.zaproxy.org/docs/alerts/10044-1/",
                  "https://developer.mozilla.org/en-US/docs/Web/HTTP/Redirections",
                  "https://owasp.org/www-project-web-security-testing-guide/v42/4-Web_Application_Security_Testing/01-Information_Gathering/05-Review_Webpage_Content_for_Information_Leakage"
                ],
                "solution": {
                  "text": "Ensure that 3xx HTTP responses only return the appropriate redirection headers and do not include unnecessary HTML content. If user feedback is required, provide a clear message without interactive elements (like links or forms). Always rely on the Location header for redirection logic."
                },
                "confidence": "medium"
              },
              "relationships": [
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "200",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  }
                },
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "WSTG-INFO-05",
                    "toolComponent": {
                      "name": "OWASP WSTG"
                    }
                  }
                }
              ],
              "shortDescription": {
                "text": "Inconsistent Redirection"
              }
            },
            {
              "id": "wapiti-information-disclosure-full-path",
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "The application response discloses full system paths. This information can help attackers understand the server environment, directory structure, and operating system, which can facilitate further attacks."
              },
              "name": "Information Disclosure - Full Path",
              "properties": {
                "references": [
                  "https://owasp.org/www-project-web-security-testing-guide/latest/4-Web_Application_Security_Testing/01-Information_Gathering/05-Review_Web_Page_Content_for_Information_Leakage",
                  "https://cwe.mitre.org/data/definitions/209.html",
                  "http://projects.webappsec.org/w/page/13246936/Information%20Leakage"
                ],
                "solution": {
                  "text": "Ensure that error messages and application responses do not disclose full filesystem paths or other sensitive system information. Use generic error messages for end users and log detailed errors only on the server side."
                },
                "confidence": "medium"
              },
              "relationships": [
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
