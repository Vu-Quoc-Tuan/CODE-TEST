                    "superset"
                  ],
                  "target": {
                    "id": "WSTG-ERRH-01",
                    "toolComponent": {
                      "name": "OWASP WSTG"
                    }
                  }
                }
              ],
              "shortDescription": {
                "text": "Information Disclosure - Full Path"
              }
            },
            {
              "id": "wapiti-ldap-injection",
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "LDAP Injection is an attack used to exploit web based applications that construct LDAP statements based on user input. When an application fails to properly sanitize user input, it’s possible to modify LDAP statements using a local proxy. This could result in the execution of arbitrary commands such as granting permissions to unauthorized queries."
              },
              "name": "LDAP Injection",
              "properties": {
                "references": [
                  "https://owasp.org/www-community/attacks/LDAP_Injection",
                  "https://cheatsheetseries.owasp.org/cheatsheets/LDAP_Injection_Prevention_Cheat_Sheet.html",
                  "https://cwe.mitre.org/data/definitions/90.html"
                ],
                "solution": {
                  "text": "To protect against XPATH injection, Escape all variables using the right LDAP encoding function. Use Frameworks that Automatically Protect from LDAP Injection."
                },
                "confidence": "medium"
              },
              "relationships": [
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "90",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  }
                },
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "WSTG-INPV-06",
                    "toolComponent": {
                      "name": "OWASP WSTG"
                    }
                  }
                }
              ],
              "shortDescription": {
                "text": "LDAP Injection"
              }
            },
            {
              "id": "wapiti-log4shell",
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Apache Log4j2 <=2.14.1 JNDI features used in configuration, log messages, and parameters do not protect against attacker controlled LDAP and other JNDI related endpoints. An attacker who can control log messages or log message parameters can execute arbitrary code loaded from LDAP servers when message lookup substitution is enabled."
              },
              "name": "Log4Shell",
              "properties": {
                "references": [
                  "https://nvd.nist.gov/vuln/detail/CVE-2021-44228",
                  "https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2021-44228",
                  "https://owasp.org/www-project-web-security-testing-guide/v42/4-Web_Application_Security_Testing/07-Input_Validation_Testing/11-Testing_for_Code_Injection"
                ],
                "solution": {
                  "text": "From log4j 2.15.0, this behavior has been disabled by default. In previous releases (>2.10) this behavior can be mitigated by setting system property \"log4j2.formatMsgNoLookups\" to \"true\" or it can be mitigated in prior releases (<2.10) by removing the JndiLookup class from the classpath (example: zip -q -d log4j-core-*.jar org/apache/logging/log4j/core/lookup/JndiLookup.class)."
                },
                "confidence": "medium"
              },
              "relationships": [
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "94",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  }
                },
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "WSTG-INPV-11",
                    "toolComponent": {
                      "name": "OWASP WSTG"
                    }
                  }
                }
              ],
              "shortDescription": {
                "text": "Log4Shell"
              }
            },
            {
              "id": "wapiti-ns-takeover",
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "A DNS NS record points to a non existing domain that an attacker can take control of, allowing them to hijack the entire DNS zone."
              },
              "name": "NS takeover",
              "properties": {
                "references": [
                  "https://0xpatrik.com/subdomain-takeover-ns/",
                  "https://projectdiscovery.io/blog/guide-to-dns-takeovers",
                  "https://krebsonsecurity.com/2025/01/mastercard-dns-error-went-unnoticed-for-years/"
                ],
                "solution": {
                  "text": "Prevent dangling DNS entries by making sure you already have control over the pointed domain. Remove any NS record pointing to an external domain you don't use."
                },
                "confidence": "medium"
              },
              "relationships": [
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
