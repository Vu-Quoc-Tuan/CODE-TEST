                    "toolComponent": {
                      "name": "OWASP WSTG"
                    }
                  }
                }
              ],
              "shortDescription": {
                "text": "Clickjacking Protection"
              }
            },
            {
              "id": "wapiti-http-strict-transport-security-hsts",
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "HSTS is a web security policy mechanism that helps to protect websites against man-in-the-middle attacks such as protocol downgrade attacks and cookie hijacking."
              },
              "name": "HTTP Strict Transport Security (HSTS)",
              "properties": {
                "references": [
                  "https://owasp.org/www-project-web-security-testing-guide/latest/4-Web_Application_Security_Testing/02-Configuration_and_Deployment_Management_Testing/07-Test_HTTP_Strict_Transport_Security",
                  "https://www.keycdn.com/support/hsts"
                ],
                "solution": {
                  "text": "Implement the HTTP Strict Transport Security header to enforce secure connections to the server."
                },
                "confidence": "medium"
              },
              "relationships": [
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "319",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  }
                },
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "WSTG-CONF-07",
                    "toolComponent": {
                      "name": "OWASP WSTG"
                    }
                  }
                },
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "OSHP-HTTP-Strict-Transport-Security",
                    "toolComponent": {
                      "name": "OWASP WSTG"
                    }
                  }
                }
              ],
              "shortDescription": {
                "text": "HTTP Strict Transport Security (HSTS)"
              }
            },
            {
              "id": "wapiti-mime-type-confusion",
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "MIME type confusion can occur when a browser interprets files as a different type than intended, which could lead to security vulnerabilities like cross-site scripting (XSS)."
              },
              "name": "MIME Type Confusion",
              "properties": {
                "references": [
                  "https://owasp.org/www-community/attacks/MIME_sniffing",
                  "https://www.keycdn.com/support/preventing-mime-type-sniffing"
                ],
                "solution": {
                  "text": "Implement X-Content-Type-Options to prevent MIME type sniffing."
                },
                "confidence": "medium"
              },
              "relationships": [
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
