            {
              "id": "wapiti-command-execution",
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "This attack consists in executing system commands on the server. The attacker tries to inject this commands in the request parameters."
              },
              "name": "Command execution",
              "properties": {
                "references": [
                  "https://owasp.org/www-project-web-security-testing-guide/latest/4-Web_Application_Security_Testing/07-Input_Validation_Testing/12-Testing_for_Command_Injection",
                  "https://cwe.mitre.org/data/definitions/78.html"
                ],
                "solution": {
                  "text": "Prefer working without user input when using file system calls."
                },
                "confidence": "medium"
              },
              "relationships": [
                {
                  "kinds": [
