            {
              "id": "10027",
              "defaultConfiguration": {
                "level": "none"
              },
              "fullDescription": {
                "text": "The response appears to contain suspicious comments which may help an attacker."
              },
              "name": "Information Disclosure - Suspicious Comments",
              "properties": {
                "references": [],
                "solution": {
                  "text": "Remove all comments that return information that may help an attacker and fix any underlying problems they refer to."
