                      "name": "CWE"
                    }
                  }
                },
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "WSTG-ATHN-07",
                    "toolComponent": {
                      "name": "OWASP WSTG"
                    }
                  }
                }
              ],
              "shortDescription": {
                "text": "Weak credentials"
              }
            },
            {
              "id": "wapiti-crlf-injection",
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "The term CRLF refers to Carriage Return (ASCII 13, \\r) Line Feed (ASCII 10, \\n). A CRLF Injection attack occurs when a user manages to submit a CRLF into an application. This is most commonly done by modifying an HTTP parameter or URL."
              },
              "name": "CRLF Injection",
              "properties": {
                "references": [
                  "https://owasp.org/www-community/vulnerabilities/CRLF_Injection",
                  "https://www.acunetix.com/websitesecurity/crlf-injection/",
                  "https://cwe.mitre.org/data/definitions/93.html",
                  "https://owasp.org/www-project-web-security-testing-guide/latest/4-Web_Application_Security_Testing/07-Input_Validation_Testing/15-Testing_for_HTTP_Splitting_Smuggling"
                ],
                "solution": {
                  "text": "Check the submitted parameters and do not allow CRLF to be injected when it is not expected."
                },
                "confidence": "medium"
              },
              "relationships": [
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "93",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  }
                },
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "WSTG-INPV-15",
                    "toolComponent": {
                      "name": "OWASP WSTG"
                    }
                  }
                }
              ],
              "shortDescription": {
                "text": "CRLF Injection"
              }
            },
            {
              "id": "wapiti-content-security-policy-configuration",
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Content Security Policy (CSP) is an added layer of security that helps to detect and mitigate certain types of attacks, including Cross Site Scripting (XSS) and data injection attacks."
              },
              "name": "Content Security Policy Configuration",
              "properties": {
                "references": [
                  "https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP",
                  "https://cheatsheetseries.owasp.org/cheatsheets/Content_Security_Policy_Cheat_Sheet.html",
                  "https://owasp.org/www-pdf-archive/2019-02-22_-_How_do_I_Content_Security_Policy_-_Print.pdf",
                  "https://owasp.org/www-project-web-security-testing-guide/latest/4-Web_Application_Security_Testing/02-Configuration_and_Deployment_Management_Testing/12-Test_for_Content_Security_Policy"
                ],
                "solution": {
                  "text": "Configuring Content Security Policy involves adding the Content-Security-Policy HTTP header to a web page and giving it values to control what resources the user agent is allowed to load for that page."
                },
                "confidence": "medium"
              },
              "relationships": [
