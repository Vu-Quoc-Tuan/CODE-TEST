            {
              "id": "10010",
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "A cookie has been set without the HttpOnly flag, which means that the cookie can be accessed by JavaScript. If a malicious script can be run on this page then the cookie will be accessible and can be transmitted to another site. If this is a session cookie then session hijacking may be possible."
              },
              "name": "Cookie No HttpOnly Flag",
              "properties": {
                "references": [
                  "https://owasp.org/www-community/HttpOnly"
                ],
                "solution": {
                  "text": "Ensure that the HttpOnly flag is set for all cookies."
                },
                "confidence": "medium"
              },
              "relationships": [
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "guid": "3b219658-b060-3ce2-9009-97890c7cea66",
