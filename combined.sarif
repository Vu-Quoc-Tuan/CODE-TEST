            {
              "id": "wapiti-htaccess-bypass",
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Htaccess files are used to restrict access to some files or HTTP method. In some case it may be possible to bypass this restriction and access the files."
              },
              "name": "Htaccess Bypass",
              "properties": {
                "references": [
                  "http://blog.teusink.net/2009/07/common-apache-htaccess-misconfiguration.html",
                  "https://cwe.mitre.org/data/definitions/538.html",
                  "https://owasp.org/www-project-web-security-testing-guide/latest/4-Web_Application_Security_Testing/02-Configuration_and_Deployment_Management_Testing/06-Test_HTTP_Methods"
                ],
                "solution": {
                  "text": "Make sure every HTTP method is forbidden if the credentials are bad."
                },
                "confidence": "medium"
              },
              "relationships": [
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
                    "id": "538",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  }
                },
                {
                  "kinds": [
                    "superset"
                  ],
                  "target": {
